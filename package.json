{
    "name": "g-lang-tools",
    "version": "3.6.0",
    "description": "A collection of common development tools",
    "homepage": "https://www.tool-box.vip",
    "license": "MIT",
    "type": "module",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "keywords": [
        "TypeScript",
        "lang",
        "tool"
    ],
    "scripts": {
        "dev": "npm run build && vite",
        "build": "rollup -c",
        "build:watch": "rollup -c --watch",
        "clean": "rm -rf dist dist-test",
        "prepublishOnly": "npm run clean && npm run build",
        "test": "echo \"No tests specified\" && exit 0",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^25.0.7",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^11.1.5",
        "@types/crypto-js": "^4.2.2",
        "@types/node": "^24.3.0",
        "@types/qs": "^6.9.11",
        "rollup": "^4.10.0",
        "rollup-plugin-dts": "^6.1.0",
        "rollup-plugin-filesize": "^10.0.0",
        "tslib": "^2.6.2",
        "typescript": "^5.3.3",
        "vite": "^5.1.3"
    },
    "dependencies": {
        "axios": "^1.6.7",
        "crypto-js": "^4.2.0",
        "dayjs": "^1.11.10",
        "qs": "^6.12.1"
    },
    "contributors": [],
    "author": {
        "email": "729170207@qq.com",
        "name": "Gene Yang",
        "url": "https://github.com/Talkyunyun"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Talkyunyun/g-lang-tools.git"
    },
    "bugs": {
        "url": "https://github.com/Talkyunyun/g-lang-tools/issues"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    }
